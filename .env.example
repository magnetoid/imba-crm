# ═══════════════════════════════════════════════════════
#  Imba CRM — root deployment (Coolify) env
#  Copy to .env and fill in values. NEVER commit .env.
#
#  This env is consumed by docker-compose.yml + the
#  model-router HTTP server (packages/model-router/dist/server.js).
#
#  For the Supabase self-hosted stack used by the frontend,
#  see packages/frontend/.env.example.
# ═══════════════════════════════════════════════════════

# ── App ─────────────────────────────────────────────────
# This Coolify project serves crm.imbaproduction.com only.
# (imbaproduction.com and imbamarketing.com are separate Coolify
# projects from different repos — do not configure them here.)
# Coolify maps service names to domains via its UI, so no host
# port bindings are needed. Domain mapping lives in
# docker_compose_domains on the Coolify Application resource.
CRM_URL=https://crm.imbaproduction.com

# ── Datastores & Supabase ───────────────────────────────
POSTGRES_USER=supabase
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=postgres
DATABASE_URL=postgres://supabase:change-me-strong-password@supabase-db:5432/postgres

REDIS_PASSWORD=change-me-redis-password
REDIS_URL=redis://:change-me-redis-password@supabase-redis:6379/0

# Supabase secrets (Must be secure and at least 32 chars)
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_EXPIRY=3600
SUPABASE_ANON_KEY=your-super-secret-anon-key
SUPABASE_SERVICE_KEY=your-super-secret-service-key
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=changeme_dashboard

# ── Model-router providers ──────────────────────────────
# Only providers with a key set will be callable. The router
# falls through its policy chain, so unset providers are skipped.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
DEEPGRAM_API_KEY=
PERPLEXITY_API_KEY=

# Ollama: set OLLAMA_BASE_URL if running a remote Ollama.
# Local-only deployments can leave both blank.
OLLAMA_API_KEY=
OLLAMA_BASE_URL=

# ── Router API auth ────────────────────────────────────
# When set, /api/ai/* endpoints require:
#   Authorization: Bearer <ROUTER_API_TOKEN>
# Recommended for any public-facing deployment. Leave blank
# only for internal network use behind another gateway.
ROUTER_API_TOKEN=
